<?xml version="1.0" encoding="UTF-8"?>

<mets:mets xmlns:mets="http://www.exlibrisgroup.com/xsd/dps/rosettaMets" 
		   xmlns:dc="http://purl.org/dc/elements/1.1/"
		   xmlns:dcterms="http://purl.org/dc/terms/"
		   xmlns:xlink="http://www.w3.org/1999/xlink"
		   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		   xmlns="http://www.exlibrisgroup.com/dps/dnx">
 <!-- Oben: Namespaces -->

  <!-- Descriptive Metadata Section für die Intellectual Entity -->
  <mets:dmdSec ID="ie-dmd">
    <mets:mdWrap MDTYPE="DC">
      <mets:xmlData>
	  <!-- Dublin Core Metadaten -->
        <dc:record>
			<dc:title>BEISPIEL METS SIP: Beispieldaten für einen METS-Ingest nach Rosetta</dc:title>
            <dc:creator>Demo, Denise</dc:creator>
            <dc:description>Exemplarische Fotosammlung für die Langzeitverfügbarkeit als TIFF und PDF</dc:description>
			<dc:date>2025-06-17</dc:date>
			<dcterms:dateSubmitted>2026-09-25</dcterms:dateSubmitted>
            <dc:type>example dataset</dc:type>
            <dc:type>demo dataset</dc:type>
			<dc:format>image/tiff</dc:format>
            <dc:format>application/pdf</dc:format>
            <dc:identifier>hbz:lzv:123456789</dc:identifier>
			<dc:rights>https://creativecommons.org/licenses/by-nc/4.0/</dc:rights>
			<dc:collection>Demo Collection\Beispiel METS SIP</dc:collection> <!-- Pfad für das Anlegen einer hierarchischen Collection in Rosetta -->	
        </dc:record>
      </mets:xmlData>
    </mets:mdWrap>
  </mets:dmdSec>
  <!-- Administrative Metadata Section für die Intellectual Entity -->
  <mets:amdSec ID="ie-amd">
  <!-- Technical Metadata Section für die Intellectual Entity -->
    <mets:techMD ID="ie-amd-tech">
      <mets:mdWrap MDTYPE="OTHER" OTHERMDTYPE="dnx">
        <mets:xmlData>
          <dnx>
            <!-- Object Identifier Section für die Intellectual Entity -->
			<section id="objectIdentifier">
              <record>
                <key id="objectIdentifierType">OAI</key>
                <key id="objectIdentifierValue">oai:hbz-example:143</key> <!-- Eineindeutiger Identifier des OAI-Records. Hiermit gleich Der Rosetta-Harvester ab, ob sich die IE schon im Permanent befindet -->
              </record>
            </section>
          </dnx>
        </mets:xmlData>
      </mets:mdWrap>
    </mets:techMD>
	<!-- Rights Metadata Section für die Intellectual Entity -->
    <mets:rightsMD ID="ie-amd-rights">
      <mets:mdWrap MDTYPE="OTHER" OTHERMDTYPE="dnx">
        <mets:xmlData>
          <dnx>
		  <!-- Access Rights Section für die Intellectual Entity -->
            <section id="accessRightsPolicy"/> <!-- Wird von Rosetta mit der gewählten Access Rights Policy gefüllt -->
          </dnx>
        </mets:xmlData>
      </mets:mdWrap>
    </mets:rightsMD>
	<!-- Source Metadata Section für die Intellectual Entity -->
	<mets:sourceMD ID="ie-amd-source-OTHER">
          <mets:mdWrap MDTYPE="OTHER" OTHERMDTYPE="Text">
		   <mets:xmlData>
			<Platzhalter>Quellmetadaten als Freitextfeld</Platzhalter> <!-- Block für Quellmetadaten, wird so eingefügt wie im Quellsystem vorhanden -->
		   </mets:xmlData>				
          </mets:mdWrap>
        </mets:sourceMD>
	<!-- Digital Provenance Metadata Section für die Intellectual Entity -->
    <mets:digiprovMD ID="ie-amd-digiprov">
      <mets:mdWrap MDTYPE="OTHER" OTHERMDTYPE="dnx">
        <mets:xmlData>
          <dnx/> <!-- Wird von Rosetta mit Provenance Events befüllt -->
        </mets:xmlData>
      </mets:mdWrap>
    </mets:digiprovMD>
  </mets:amdSec>
  <!-- Administrative Metadata Section für Representation 1 -->
  <mets:amdSec ID="rep1-amd"> <!-- Namenskonvention: rep1, rep2, rep3 usw. Kann aber auch frei gewählt werden -->
  <!-- Technical Metadata Section für Representation 1 -->
    <mets:techMD ID="rep1-amd-tech">
      <mets:mdWrap MDTYPE="OTHER" OTHERMDTYPE="dnx">
        <mets:xmlData>
          <dnx>
		  <!-- General Characteristics Section für Representation 1 -->
            <section id="generalRepCharacteristics">
              <record>
                <key id="label">TIFF</key> <!-- Label für IE Viewer Tabs links -->
                <key id="preservationType">PRESERVATION_MASTER</key>
                <key id="usageType">VIEW</key> <!-- Nur der Default "View" ist hier möglich -->
              </record>
            </section>
          </dnx>
        </mets:xmlData>
      </mets:mdWrap>
    </mets:techMD>
  </mets:amdSec>
  <!-- Administrative Metadata Section für File 1 in Representation 1 -->
  <mets:amdSec ID="fid1-1-amd"> <!-- ID verbindet File-amdSec mit entsprechender Datei in fileSec. Namenskonvention für IDs: ID="fid{m}-{n}" m = file counter n = representation counter-->
  <!-- Technical Metadata Section für File 1 in Representation 1 -->
    <mets:techMD ID="fid1-1-amd-tech">
      <mets:mdWrap MDTYPE="OTHER" OTHERMDTYPE="dnx">
        <mets:xmlData>
          <dnx>
		  <!-- General Characteristics Section für File 1 in Representation 1 -->
            <section id="generalFileCharacteristics">
              <record>
                <key id="label">TIFF Version</key>
				<key id="fileOriginalName">Beispielname1</key>
                <key id="fileMIMEType">image/tiff</key>
              </record>
            </section>
			<!-- File Fixity Section für File 1 in Representation 1 -->
			<section id="fileFixity">
			  <record>
				<key id="pluginName">CustomFixitySHA512Plugin</key>
				<key id="fixityType">SHA-512</key>
				<key id="fixityValue">98fb815042ca673012ade5cf099e2e1b8919685eb417cde4e5ddcee5bc547870af6e3b99a619850b5ba24eb576e789153781f94566c13d6af8c8bf7ef64f38a4</key>
			 </record>
			</section>
          </dnx>
        </mets:xmlData>
      </mets:mdWrap>
    </mets:techMD>
	<!-- Rights Section für File 1 in Representation 1 -->
	<mets:rightsMD ID="fid1-1-amd-rights">
      <mets:mdWrap MDTYPE="OTHER" OTHERMDTYPE="dnx">
        <mets:xmlData>
          <dnx>
		  <!-- Access Rights Policy Section für File 1 in Representation 1 -->
            <section id="accessRightsPolicy"/> <!-- Wird i. d. R. von Rosetta befüllt, kann aber auch vorher ausgefüllt werden  -->
          </dnx>
        </mets:xmlData>
      </mets:mdWrap>
    </mets:rightsMD>
  </mets:amdSec>
  <!-- File 2 in REP 1 -->
  <mets:amdSec ID="fid2-1-amd"> <!-- ID verbindet File-amdSec mit entsprechender Datei in fileSec. Namenskonvention für IDs: ID="fid{m}-{n}" m = file counter n = representation counter-->
  <!-- Technical Metadata Section für File 1 in Representation 1 -->
    <mets:techMD ID="fid2-1-amd-tech">
      <mets:mdWrap MDTYPE="OTHER" OTHERMDTYPE="dnx">
        <mets:xmlData>
          <dnx>
		  <!-- General Characteristics Section für File 2 in Representation 1 -->
            <section id="generalFileCharacteristics">
              <record>
                <key id="label">TIFF Version</key>
				<key id="fileOriginalName">Beispielname2</key>
                <key id="fileMIMEType">image/tiff</key>
              </record>
            </section>
			<!-- File Fixity Section für File 2 in Representation 1 -->
			<section id="fileFixity">
			  <record>
				<key id="pluginName">CustomFixitySHA512Plugin</key>
				<key id="fixityType">SHA-512</key>
				<key id="fixityValue">0cfc46e17200b96f7165a6fe7fc0586316d31d24d49908fd63dd679f815435eac2ddbeb27d952955a476d6edacf107116ea26111755a0602d5655846c41e8e72</key>
			 </record>
			</section>
          </dnx>
        </mets:xmlData>
      </mets:mdWrap>
    </mets:techMD>
	<!-- Rights Section für File 2 in Representation 1 -->
	<mets:rightsMD ID="fid2-1-amd-rights">
      <mets:mdWrap MDTYPE="OTHER" OTHERMDTYPE="dnx">
        <mets:xmlData>
          <dnx>
		  <!-- Access Rights Policy Section für File 2 in Representation 1 -->
            <section id="accessRightsPolicy"/> <!-- Wird i. d. R. von Rosetta befüllt, kann aber auch vorher ausgefüllt werden  -->
          </dnx>
        </mets:xmlData>
      </mets:mdWrap>
    </mets:rightsMD>
  </mets:amdSec>
  <!-- Administrative Metadata Section für Representation 2 -->
  <mets:amdSec ID="rep2-amd">
  <!-- Technical Metadata Section für Representation 2 -->
    <mets:techMD ID="rep2-amd-tech">
      <mets:mdWrap MDTYPE="OTHER" OTHERMDTYPE="dnx">
        <mets:xmlData>
          <dnx>
		  <!-- General Characteristics Section für Representation 2 -->
            <section id="generalRepCharacteristics">
              <record>
                <key id="label">PDF</key> <!-- Label für IE Viewer Tabs links -->
                <key id="preservationType">MODIFIED_MASTER</key> <!-- Alternative Ausprägung des Masters -->
                <key id="usageType">VIEW</key>
				<key id="RevisionNumber">2</key> <!-- Version der REP, optional, ohne dieses Feld erzeugt Rosetta automatisch "Revision 1" -->
              </record>
            </section>
          </dnx>
        </mets:xmlData>
      </mets:mdWrap>
    </mets:techMD>
  </mets:amdSec>
  <!-- Administrative Metadata Section für File 1 in Representation 2 -->
  <mets:amdSec ID="fid1-2-amd">
  <!-- Technical Metadata Section für File 1 in Representation 2 -->
    <mets:techMD ID="fid1-2-amd-tech">
      <mets:mdWrap MDTYPE="OTHER" OTHERMDTYPE="dnx">
        <mets:xmlData>
          <dnx>
		  <!-- General Characteristics Section für File 1 in Representation 2 -->
            <section id="generalFileCharacteristics">
              <record>
                <key id="label">PDF Version</key>
				<key id="fileOriginalName">Beispielname2</key>
                <key id="fileMIMEType">application/pdf</key>
              </record>
            </section>
			<!-- File Fixity Section für File 1 in Representation 2 -->
			<section id="fileFixity">
			  <record>
				<key id="pluginName">CustomFixitySHA512Plugin</key>
				<key id="fixityType">SHA-512</key>
				<key id="fixityValue">a8bbad49b7e00bd426f7efd3a342e4ea76ecf66bbfb9ab6684643bc6dbbe296d26e80fb2e58664d522270572f9cb141824f596ec7233dd399de858964a4b3aa7</key>
			 </record>
			</section>
          </dnx>
        </mets:xmlData>
      </mets:mdWrap>
    </mets:techMD>
	<!-- Rights Section für File 1 in Representation 2 -->
	<mets:rightsMD ID="fid1-2-amd-rights">
      <mets:mdWrap MDTYPE="OTHER" OTHERMDTYPE="dnx">
        <mets:xmlData>
          <dnx>
		  <!-- Access Rights Policy Section für File 1 in Representation 2 -->
            <section id="accessRightsPolicy"/>
          </dnx>
        </mets:xmlData>
      </mets:mdWrap>
    </mets:rightsMD>
  </mets:amdSec>
  <!-- File Section -->
  <mets:fileSec>
  <!-- File Group für Representation 1 -->
    <mets:fileGrp USE="VIEW" ID="rep1" ADMID="rep1-amd"> <!-- Eine File Group entspricht einer REP -->
  <!-- File Locations für Representation 1 -->
      <mets:file ID="fid1-1" ADMID="fid1-1-amd"> <!-- Namenskonvention ADMID="fid{m}-{n}-amd"> m = file counter n = representation counter -->
        <mets:FLocat LOCTYPE="URL" xlink:href="books_01.tif"/> <!-- Link zur Datei oder Dateipfad zum I/O-Server oder Quellsystem -->
      </mets:file>
	  <mets:file ID="fid2-1" ADMID="fid2-1-amd">
        <mets:FLocat LOCTYPE="URL" xlink:href="books_02.tif"/>
      </mets:file>
    </mets:fileGrp>
	<!-- File Group für Representation 2 -->
    <mets:fileGrp USE="VIEW" ID="rep2" ADMID="rep2-amd">
      <mets:file ID="fid1-2" ADMID="fid1-2-amd">
	  <!-- File Locations für Representation 2 -->
        <mets:FLocat LOCTYPE="URL" xlink:href="books.pdf"/>
      </mets:file>
    </mets:fileGrp>
  </mets:fileSec>
  <!-- Structural Map für Representation 1 -->
  <mets:structMap ID="rep1-1" TYPE="LOGICAL"> <!-- Wird keine StructMap vorgegeben, erzeugt Rosetta automatisch eine Physical StructMap und ordnet die Dateien nach der Reihenfolge in der FileSec an. Namenskonvention ID="rep{m}-{n}"> m = representation counter n = StructMap counter -->
    <mets:div>
      <mets:div ORDERLABEL="TIFF Version" TYPE="FILE" LABEL="TIFF Version"> <!-- Label für IE Viewer in der Mitte oben -->
        <mets:fptr FILEID="fid1-1"/>
      </mets:div>
		<mets:div ORDERLABEL="TIFF Version" TYPE="FILE" LABEL="TIFF Version">
        <mets:fptr FILEID="fid2-1"/>
      </mets:div>
    </mets:div>
  </mets:structMap>
  <!-- Structural Map für Representation 2 -->
  <mets:structMap ID="rep2-1" TYPE="LOGICAL">
  <mets:div>
      <mets:div ORDERLABEL="PDF Version" TYPE="FILE" LABEL="PDF Version">
        <mets:fptr FILEID="fid1-2"/>
      </mets:div>
    </mets:div>
  </mets:structMap>
</mets:mets>