<?xml version="1.0" encoding="UTF-8"?>

<mets:mets xmlns:mets="http://www.exlibrisgroup.com/xsd/dps/rosettaMets" 
		   xmlns:dc="http://purl.org/dc/elements/1.1/"
		   xmlns:dcterms="http://purl.org/dc/terms/"
		   xmlns:xlink="http://www.w3.org/1999/xlink"
		   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		   xmlns="http://www.exlibrisgroup.com/dps/dnx">
 <!-- Oben: Verwendete Namespaces -->

  <!-- Descriptive Metadata Section für die Intellectual Entity -->
  <mets:dmdSec ID="ie-dmd">
    <mets:mdWrap MDTYPE="DC">
      <mets:xmlData>
        <dc:record>
			<dc:title>BEISPIEL METS SIP: Beispieldaten für einen METS-Ingest nach Rosetta</dc:title>
            <dc:creator>Demo, Denise</dc:creator>
            <dc:description>Exemplarische Fotosammlung für die Langzeitverfügbarkeit als TIFF und PDF</dc:description>
			<dc:date>2025-06-17</dc:date>
			<dcterms:dateSubmitted>2026-09-25</dcterms:dateSubmitted>
            <dc:type>example dataset</dc:type>
            <dc:type>demo dataset</dc:type>
			<dc:format>image/tiff</dc:format>
            <dc:format>application/pdf</dc:format>
            <dc:identifier>hbz:lzv:123456789</dc:identifier>
			<dc:rights>https://creativecommons.org/licenses/by-nc/4.0/</dc:rights>
			<dc:collection>Demo Collection\Beispiel METS SIP</dc:collection> <!-- Pfad für das Anlegen einer hierarchischen Collection in Rosetta -->	
        </dc:record>
      </mets:xmlData>
    </mets:mdWrap>
  </mets:dmdSec>
  <!-- Administrative Metadata Section für die Intellectual Entity-->
  <mets:amdSec ID="ie-amd">
    <mets:techMD ID="ie-amd-tech">
	<mets:mdWrap MDTYPE="OTHER" OTHERMDTYPE="dnx">
        <mets:xmlData>
          <dnx/>
        </mets:xmlData>
      </mets:mdWrap>
    </mets:techMD>
    <mets:rightsMD ID="ie-amd-rights">
	<mets:mdWrap MDTYPE="OTHER" OTHERMDTYPE="dnx">
        <mets:xmlData>
          <dnx/>
        </mets:xmlData>
      </mets:mdWrap>
    </mets:rightsMD>
	<!-- Source Metadata Section für die Intellectual Entity -->
	<mets:sourceMD ID="ie-amd-source-OTHER">
          <mets:mdWrap MDTYPE="OTHER" OTHERMDTYPE="Text">
		   <mets:xmlData>
            <Platzhalter>Quellmetadaten als Freitextfeld in XML.</Platzhalter> <!-- Block für Quellmetadaten, wird so eingefügt wie im Quellsystem vorhanden -->
			</mets:xmlData>				
          </mets:mdWrap>
        </mets:sourceMD>
	<!-- Digital Provenance Metadata Section für die Intellectual Entity -->
    <mets:digiprovMD ID="ie-amd-digiprov">
      <mets:mdWrap MDTYPE="OTHER" OTHERMDTYPE="dnx">
        <mets:xmlData>
          <dnx/>
        </mets:xmlData>
      </mets:mdWrap>
    </mets:digiprovMD>
  </mets:amdSec>
  <!-- Administrative Metadata Section für die Representation -->
  <mets:amdSec ID="rep1-amd"> <!-- Namenskonvention: rep1, rep2, rep3 usw. Kann aber auch frei gewählt werden -->
    <mets:techMD ID="rep1-amd-tech">
      <mets:mdWrap MDTYPE="OTHER" OTHERMDTYPE="dnx">
        <mets:xmlData>
          <dnx>
            <section id="generalRepCharacteristics">
              <record>
                <key id="preservationType">PRESERVATION_MASTER</key>
                <key id="usageType">VIEW</key> <!-- Nur der Default "View" ist hier möglich -->
              </record>
            </section>
          </dnx>
        </mets:xmlData>
      </mets:mdWrap>
    </mets:techMD>
  </mets:amdSec>
  <!-- Administrative Metadata Sections für Files -->
  <mets:amdSec ID="fid1-1-amd"/> <!-- Section kann komplett leer als eine Zeile eingefügt werden, Rosetta füllt die Metadaten entsprechend der Konfiguration ein. Namenskonvention für IDs: <mets:file ID="fid{m}-{n}" ... ADMID="fid{m}-{n}-amd"> m = file counter n = representation counter-->
  <mets:amdSec ID="fid2-1-amd"/>
  <mets:amdSec ID="fid3-1-amd"/>
  <!-- File Section -->
  <mets:fileSec>
    <mets:fileGrp USE="VIEW" ID="rep1" ADMID="rep1-amd"> <!-- Eine File Group entspricht einer REP -->
  <!-- File Locations für Representation -->
	  <mets:file ID="fid1-1" ADMID="fid1-1-amd">
        <mets:FLocat LOCTYPE="URL" xlink:href="books_01.tif"/> <!-- Link zur Datei oder Dateipfad zum I/O-Server oder Quellsystem -->
      </mets:file>
	  <mets:file ID="fid2-1" ADMID="fid2-1-amd">
        <mets:FLocat LOCTYPE="URL" xlink:href="books_02.tif"/>
      </mets:file>
	  <mets:file ID="fid3-1" ADMID="fid3-1-amd">
        <mets:FLocat LOCTYPE="URL" xlink:href="books.pdf"/>
      </mets:file>
    </mets:fileGrp>
  </mets:fileSec>
  <!-- StructMap hier nicht verwendet, da optional. Wird keine StructMap vorgegeben, erzeugt Rosetta automatisch eine Physical StructMap und ordnet die Dateien nach der Reihenfolge in der FileSec an -->
</mets:mets>